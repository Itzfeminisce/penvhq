{
  "name": "@penvhq/penv",
  "version": "0.13.0",
  "description": "Configuration that shares a data model with your production secret manager.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itzfeminisce/penvhq.git",
    "directory": "packages/penv"
  },
  "homepage": "https://github.com/Itzfeminisce/penvhq#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@penvhq/cli": "workspace:*",
    "@penvhq/provider-filesystem": "workspace:*",
    "@penvhq/runtime": "workspace:*",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@penvhq/core": "workspace:*",
    "jiti": "2.7.0"
  }
}
