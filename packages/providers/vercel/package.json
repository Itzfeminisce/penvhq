{
  "name": "@penvhq/provider-vercel",
  "version": "0.9.5",
  "description": "The Vercel project environment-variable provider — a projection-holding destination penv pushes to over the REST API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "penv": {
    "credentials": [
      "VERCEL_TOKEN"
    ]
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@penvhq/core": "workspace:*"
  }
}
